# Optional server-only key. Never expose as NEXT_PUBLIC_*.
NED_API_KEY=
# Direct ENTSO-E Transparency Platform server-only token.
ENTSOE_API_KEY=

# TenneT server-only API credential.
TENNET_API_KEY=

# Host IP that Docker publishes port 6000 on. Default: same-host Caddy only.
# If Caddy is on another VM, set the application's private LAN IP instead.
GRID_BIND_ADDRESS=127.0.0.1
